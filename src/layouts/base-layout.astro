---
import "@/styles/global.css"
import AstroSeo from "@/components/astro-seo.astro"
import Header from "@/components/header.astro"
import Footer from "@/components/footer.astro"
import Dock from "@/components/dock.astro"
import AIChat from "@/components/ai-chat.astro"
import TailwindIndicator from "@/components/ui/tailwind-indicator.astro"
import Snow from "@/components/snow.astro"

interface Props {
  title?: string
  description?: string
  canonical?: string
  ogImage?: string
}

const {
  title,
  description = "CS graduate and web developer specializing in performance optimization, clean UI design, and scalable architecture. Explore my work and get in touch.",
  canonical,
  ogImage = new URL("/open-graph/index.png", Astro.url).toString(),
} = Astro.props

const { pathname } = Astro.url
const SITE_NAME = "aleksa.codes"

const fullTitle =
  pathname !== "/" ? `${title} | ${SITE_NAME}` : `${SITE_NAME} | Web Developer`
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <AstroSeo
      title={fullTitle}
      description={description}
      canonical={canonical ||
        new URL(Astro.request.url).origin + Astro.url.pathname}
      openGraph={{
        url:
          canonical || new URL(Astro.request.url).origin + Astro.url.pathname,
        title: fullTitle,
        description,
        type: "website",
        locale: "en_US",
        site_name: "Aleksa",
        images: [{ url: ogImage, alt: fullTitle }],
      }}
      twitter={{
        cardType: "summary_large_image",
      }}
      additionalLinkTags={[
        { rel: "icon", type: "image/x-icon", href: "/favicon.ico" },
        { rel: "sitemap", href: "/sitemap-index.xml" },
        {
          rel: "preload",
          href: "/fonts/Geist.woff2",
          as: "font",
          type: "font/woff2",
          crossOrigin: "anonymous",
        },
        {
          rel: "preload",
          href: "/fonts/GeistMono.woff2",
          as: "font",
          type: "font/woff2",
          crossOrigin: "anonymous",
        },
        {
          rel: "alternate",
          type: "application/rss+xml",
          href: new URL("rss.xml", Astro.site).toString(),
        },
      ]}
    />
    <script is:inline>
      ;(function () {
        var theme =
          localStorage.getItem("theme") ||
          (matchMedia("(prefers-color-scheme: dark)").matches
            ? "dark"
            : "light")
        document.documentElement.classList.toggle("dark", theme === "dark")
      })()
    </script>
    <style is:inline>
      /* Critical theme variables for dark mode. Must stay in sync with the
         .dark block in src/styles/global.css. Inlined here because Beasties
         (critical CSS) can't see the runtime .dark class and would otherwise
         drop these from the inline critical CSS, flashing light theme first. */
      .dark {
        --background: oklch(0 0 0);
        --foreground: oklch(1 0 0);
        --card: oklch(0.14 0 0);
        --card-foreground: oklch(1 0 0);
        --popover: oklch(0.18 0 0);
        --popover-foreground: oklch(1 0 0);
        --primary: oklch(1 0 0);
        --primary-foreground: oklch(0 0 0);
        --secondary: oklch(0.25 0 0);
        --secondary-foreground: oklch(1 0 0);
        --muted: oklch(0.23 0 0);
        --muted-foreground: oklch(0.72 0 0);
        --accent: oklch(0.32 0 0);
        --accent-foreground: oklch(1 0 0);
        --destructive: oklch(0.69 0.2 23.91);
        --destructive-foreground: oklch(0 0 0);
        --border: oklch(0.26 0 0);
        --input: oklch(0.32 0 0);
        --ring: oklch(0.72 0 0);
        --chart-1: oklch(0.81 0.17 75.35);
        --chart-2: oklch(0.58 0.21 260.84);
        --chart-3: oklch(0.56 0 0);
        --chart-4: oklch(0.44 0 0);
        --chart-5: oklch(0.92 0 0);
        --sidebar: oklch(0.18 0 0);
        --sidebar-foreground: oklch(1 0 0);
        --sidebar-primary: oklch(1 0 0);
        --sidebar-primary-foreground: oklch(0 0 0);
        --sidebar-accent: oklch(0.32 0 0);
        --sidebar-accent-foreground: oklch(1 0 0);
        --sidebar-border: oklch(0.32 0 0);
        --sidebar-ring: oklch(0.72 0 0);
        --radius: 0.5rem;
        --breakpoint-xs: 475px;
        --shadow-x: 0px;
        --shadow-y: 1px;
        --shadow-blur: 2px;
        --shadow-spread: 0px;
        --shadow-opacity: 0.18;
        --shadow-color: hsl(0 0% 0%);
        --shadow-2xs: 0px 1px 2px 0px hsl(0 0% 0% / 0.09);
        --shadow-xs: 0px 1px 2px 0px hsl(0 0% 0% / 0.09);
        --shadow-sm:
          0px 1px 2px 0px hsl(0 0% 0% / 0.18),
          0px 1px 2px -1px hsl(0 0% 0% / 0.18);
        --shadow:
          0px 1px 2px 0px hsl(0 0% 0% / 0.18),
          0px 1px 2px -1px hsl(0 0% 0% / 0.18);
        --shadow-md:
          0px 1px 2px 0px hsl(0 0% 0% / 0.18),
          0px 2px 4px -1px hsl(0 0% 0% / 0.18);
        --shadow-lg:
          0px 1px 2px 0px hsl(0 0% 0% / 0.18),
          0px 4px 6px -1px hsl(0 0% 0% / 0.18);
        --shadow-xl:
          0px 1px 2px 0px hsl(0 0% 0% / 0.18),
          0px 8px 10px -1px hsl(0 0% 0% / 0.18);
        --shadow-2xl: 0px 1px 2px 0px hsl(0 0% 0% / 0.45);
        --gh-0: oklch(0.25 0 0);
        --gh-1: oklch(0.3 0.1 162);
        --gh-2: oklch(0.4 0.15 162);
        --gh-3: oklch(0.5 0.2 162);
        --gh-4: oklch(0.6 0.25 162);
      }
    </style>
  </head>
  <body class="flex min-h-screen flex-col">
    <div
      class="pointer-events-none fixed inset-0 -z-50 bg-[linear-gradient(to_right,rgba(128,128,128,0.05)_1px,transparent_1px),linear-gradient(to_bottom,rgba(128,128,128,0.05)_1px,transparent_1px)] mask-[radial-gradient(circle_at_center,black_40%,transparent_100%)] bg-size-[30px_30px] opacity-50 [-webkit-mask-image:radial-gradient(circle_at_center,black_40%,transparent_100%)]"
    >
    </div>
    <Snow />
    <Header />
    <main id="main" class="container flex grow flex-col pt-32 pb-48">
      <slot />
    </main>
    <Footer />
    <Dock />
    <AIChat />
    <TailwindIndicator />
  </body>
</html>
