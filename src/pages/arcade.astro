---
import ArcadeGrid from "@/components/arcade-grid.astro"
import GamePlayer from "@/components/game-player.astro"
import PromptModal from "@/components/prompt-modal.astro"
import Button from "@/components/ui/button.astro"
import { Icon } from "astro-icon/components"
import { sortedGames } from "@/lib/arcade"
import BaseLayout from "@/layouts/base-layout.astro"

const title = "Arcade"
const description =
  "A collection of small browser games written entirely by AI models. Each one is a single HTML file, playable right here, with the model and prompt behind it."
const ogImage = new URL("/open-graph/arcade.png", Astro.site).toString()
---

<BaseLayout {title} {description} {ogImage}>
  <div class="flex flex-col gap-12">
    <div class="flex flex-col items-start">
      <h1 class="mb-3 text-3xl font-bold tracking-tighter text-foreground md:text-4xl">
        The{" "}
        <span class="bg-linear-to-r from-foreground to-muted-foreground bg-clip-text text-transparent">
          Arcade.
        </span>
      </h1>
      <p class="max-w-2xl text-base leading-relaxed text-pretty text-muted-foreground">
        Small browser games written by AI from a single prompt, playable right
        here. Every card shows the model and the exact prompt behind it, so you
        can watch them improve over time.
      </p>
    </div>

    <ArcadeGrid games={sortedGames} priority />

    <div class="flex justify-center">
      <Button
        href="/contact"
        variant="outline"
        size="xl"
        class="h-11 gap-2.5 px-5 text-base transition-colors hover:border-foreground/20 motion-reduce:transition-none"
      >
        <Icon name="lucide:lightbulb" class="size-5" />
        Suggest a game
        <Icon name="lucide:arrow-right" class="size-4 text-muted-foreground" />
      </Button>
    </div>
  </div>

  <GamePlayer />
  <PromptModal />
</BaseLayout>
