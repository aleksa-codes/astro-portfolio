---
import BaseLayout from "@/layouts/base-layout.astro"
import { Icon } from "astro-icon/components"
import Button from "@/components/ui/button.astro"
import Input from "@/components/ui/input.astro"
import Textarea from "@/components/ui/textarea.astro"
import Avatar from "@/components/avatar.astro"
import { cn } from "@/lib/utils"

const title = "Contact"
const description =
  "Have a project in mind or want to collaborate? Reach out for freelance work, partnerships, or a conversation. I'd love to hear from you."
const ogImage = new URL("/open-graph/contact.png", Astro.site).toString()
const contactLinkClass =
  "flex min-h-12 items-center gap-3 border-b border-border py-3 text-base text-foreground outline-none hover:text-muted-foreground focus-visible:rounded-sm focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-ring"
---

<BaseLayout {title} {description} {ogImage}>
  <div class="flex flex-col gap-12">
    <div>
      <h1 class="mb-3 text-3xl font-bold tracking-tighter text-foreground md:text-4xl">
        Get in{" "}
        <span class="bg-linear-to-r from-foreground to-muted-foreground bg-clip-text text-transparent">
          Touch.
        </span>
      </h1>
      <p class="max-w-xl text-base leading-relaxed text-pretty text-muted-foreground">
        Have a project in mind, a question, or just want to say hello? I'm
        always open to new opportunities and interesting conversations.
      </p>
    </div>

    <div class="grid gap-10 border-t border-border pt-8 lg:grid-cols-[240px_minmax(0,1fr)] lg:gap-12">
      <aside aria-label="Direct contact" class="flex min-w-0 flex-col gap-6">
        <div class="grid grid-cols-[104px_minmax(0,1fr)] items-center gap-x-4 gap-y-1 lg:grid-cols-[96px_minmax(0,1fr)] lg:gap-y-6">
          <div class="row-span-2 flex lg:row-span-1">
            <Avatar class="size-26 lg:size-24" />
          </div>
          <div class="min-w-0">
            <h2 class="text-2xl font-semibold tracking-tight text-foreground">
              Aleksa
            </h2>
            <p class="mt-1 text-sm text-muted-foreground">
              Full-stack web developer
            </p>
          </div>
          <div class="col-start-2 flex flex-col gap-1 text-sm text-muted-foreground lg:col-span-2 lg:col-start-1 lg:gap-2">
            <p class="inline-flex items-center gap-2">
              <Icon name="lucide:map-pin" class="size-4" />
              Belgrade, Serbia
            </p>
            <p class="inline-flex items-center gap-2">
              <Icon name="lucide:clock" class="size-4" />
              <time id="contact-local-time" class="tabular-nums">
                Local time in Belgrade
              </time>
            </p>
          </div>
        </div>
        <nav
          aria-label="Contact links"
          class="grid grid-cols-2 gap-x-4 lg:grid-cols-1"
        >
          <a
            href="mailto:hello@aleksa.codes"
            class={cn(contactLinkClass, "col-span-2 lg:col-span-1")}
          >
            <Icon
              name="lucide:mail"
              class="size-4 shrink-0 text-muted-foreground"
            />
            hello@aleksa.codes
            <Icon
              name="lucide:arrow-up-right"
              class="ml-auto size-4 shrink-0 text-muted-foreground"
            />
          </a>
          <a
            href="https://discordapp.com/users/1078249969775038514"
            target="_blank"
            rel="noopener noreferrer"
            class={contactLinkClass}
          >
            <Icon
              name="simple-icons:discord"
              class="size-4 shrink-0 text-muted-foreground"
            />
            Discord
            <Icon
              name="lucide:arrow-up-right"
              class="ml-auto size-4 shrink-0 text-muted-foreground"
            />
          </a>
          <a
            href="https://github.com/aleksa-codes"
            target="_blank"
            rel="noopener noreferrer"
            class={contactLinkClass}
          >
            <Icon
              name="lucide:github"
              class="size-4 shrink-0 text-muted-foreground"
            />
            GitHub
            <Icon
              name="lucide:arrow-up-right"
              class="ml-auto size-4 shrink-0 text-muted-foreground"
            />
          </a>
        </nav>
      </aside>

      <div class="min-w-0">
        <div
          id="success-message"
          class="hidden flex-col items-start gap-4 py-8"
          role="status"
        >
          <Icon
            name="lucide:check"
            class="size-6 text-green-600 dark:text-green-400"
          />
          <h2
            id="success-heading"
            tabindex="-1"
            class="text-2xl font-semibold tracking-tight text-foreground outline-none"
          >
            Message sent.
          </h2>
          <p class="max-w-sm text-base leading-relaxed text-muted-foreground">
            Thanks for reaching out. I'll get back to you as soon as I can.
          </p>
          <Button
            type="button"
            id="send-another"
            variant="outline"
            size="xl"
            class="mt-2 h-11 rounded-lg px-4 text-base"
          >
            Send another message
          </Button>
        </div>

        <form
          id="contact-form"
          name="contact"
          method="POST"
          data-netlify="true"
          data-netlify-recaptcha="true"
          netlify-honeypot="bot-field"
          aria-label="Send a message"
          class="flex flex-col gap-6"
        >
          <p class="hidden">
            <label>
              Don't fill this out if you're human: <input name="bot-field" />
            </label>
          </p>
          <input type="hidden" name="form-name" value="contact" />

          <div class="grid gap-6 sm:grid-cols-2">
            <div class="flex flex-col gap-2">
              <label for="name" class="text-sm font-medium text-foreground">
                Name
              </label>
              <Input
                id="name"
                name="name"
                type="text"
                autocomplete="name"
                placeholder="Your name"
                required
                class="h-12 px-3 text-base focus-visible:ring-2 focus-visible:ring-ring/15"
              />
            </div>
            <div class="flex flex-col gap-2">
              <label for="email" class="text-sm font-medium text-foreground">
                Email
              </label>
              <Input
                id="email"
                name="email"
                type="email"
                autocomplete="email"
                placeholder="you@example.com"
                required
                class="h-12 px-3 text-base focus-visible:ring-2 focus-visible:ring-ring/15"
              />
            </div>
          </div>
          <div class="flex flex-col gap-2">
            <label for="subject" class="text-sm font-medium text-foreground">
              Subject
            </label>
            <Input
              id="subject"
              name="subject"
              type="text"
              placeholder="What do you have in mind?"
              required
              class="h-12 px-3 text-base focus-visible:ring-2 focus-visible:ring-ring/15"
            />
          </div>
          <div class="flex flex-col gap-3">
            <div class="flex flex-col gap-2">
              <label for="message" class="text-sm font-medium text-foreground">
                Message
              </label>
              <Textarea
                id="message"
                name="message"
                rows="5"
                placeholder="Tell me a little about your project or question..."
                required
                class="min-h-48 px-3 py-3 text-base focus-visible:ring-2 focus-visible:ring-ring/15"
              />
            </div>
            <p
              id="form-error"
              role="alert"
              class="hidden text-sm leading-relaxed text-destructive"
            ></p>
            <div class="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between sm:gap-4">
              {import.meta.env.DEV ? (
                <div
                  data-captcha-preview
                  role="note"
                  aria-label="Development CAPTCHA placeholder"
                  class="flex h-[78px] w-[304px] shrink-0 items-center gap-3 self-center rounded-md border border-dashed border-border bg-muted/30 px-4 text-sm sm:self-start"
                >
                  <Icon
                    name="lucide:shield-check"
                    class="size-5 shrink-0 text-muted-foreground"
                  />
                  <div>
                    <p class="font-medium text-foreground">CAPTCHA</p>
                    <p class="text-muted-foreground">Development preview</p>
                  </div>
                </div>
              ) : (
                <div
                  data-netlify-recaptcha="true"
                  class="self-center empty:hidden sm:self-start"
                ></div>
              )}
              <Button
                id="contact-submit"
                type="submit"
                size="xl"
                class="h-12 w-full gap-2 rounded-lg px-5 text-base sm:w-auto sm:shrink-0"
              >
                <Icon name="lucide:send" class="size-4" />
                <span id="contact-submit-label">Send message</span>
              </Button>
            </div>
          </div>
        </form>
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  const localTime = document.querySelector<HTMLTimeElement>(
    "#contact-local-time"
  )
  if (localTime) {
    const formatter = new Intl.DateTimeFormat("en-GB", {
      timeZone: "Europe/Belgrade",
      hour: "2-digit",
      minute: "2-digit",
      hourCycle: "h23",
    })
    let timer: ReturnType<typeof setTimeout> | undefined
    const updateTime = () => {
      clearTimeout(timer)
      const now = new Date()
      localTime.dateTime = now.toISOString()
      localTime.textContent = `${formatter.format(now)} local time`
      if (!document.hidden)
        timer = setTimeout(updateTime, 60_000 - (Date.now() % 60_000))
    }
    updateTime()
    document.addEventListener("visibilitychange", updateTime)
  }

  const form = document.querySelector<HTMLFormElement>("#contact-form")
  const successMessage = document.getElementById("success-message")
  const errorMessage = document.getElementById("form-error")
  const submit = document.querySelector<HTMLButtonElement>("#contact-submit")
  const submitLabel = document.getElementById("contact-submit-label")

  function getCaptcha() {
    if (!("grecaptcha" in window)) return
    const captcha = window.grecaptcha
    if (typeof captcha !== "object" || captcha === null) return
    if (
      !("getResponse" in captcha) ||
      typeof captcha.getResponse !== "function"
    )
      return
    const getResponse = captcha.getResponse
    const reset =
      "reset" in captcha && typeof captcha.reset === "function"
        ? captcha.reset
        : undefined
    return {
      getResponse: (): unknown => getResponse.call(captcha),
      reset: () => {
        reset?.call(captcha)
      },
    }
  }

  function resetCaptcha() {
    getCaptcha()?.reset()
  }

  if (form && successMessage && errorMessage && submit && submitLabel) {
    form.addEventListener("submit", async (event) => {
      event.preventDefault()
      if (submit.disabled) return
      errorMessage.classList.add("hidden")
      const captcha = getCaptcha()
      let responseToken: unknown
      try {
        responseToken = captcha?.getResponse()
      } catch {
        errorMessage.textContent =
          "Verification isn't ready yet. Please try again or email hello@aleksa.codes."
        errorMessage.classList.remove("hidden")
        return
      }
      if (typeof responseToken !== "string" || !responseToken) {
        errorMessage.textContent = captcha
          ? "Please complete the verification before sending your message."
          : "Verification is unavailable right now. Please email hello@aleksa.codes instead."
        errorMessage.classList.remove("hidden")
        return
      }

      submit.disabled = true
      submitLabel.textContent = "Sending..."
      form.setAttribute("aria-busy", "true")
      try {
        const body = new URLSearchParams()
        for (const [key, value] of new FormData(form)) {
          if (typeof value === "string") body.append(key, value)
        }
        const response = await fetch("/", {
          method: "POST",
          headers: { "Content-Type": "application/x-www-form-urlencoded" },
          body: body.toString(),
        })
        if (!response.ok) throw new Error("Submission failed")
        form.classList.add("hidden")
        successMessage.classList.replace("hidden", "flex")
        form.reset()
        document
          .getElementById("success-heading")
          ?.focus({ preventScroll: true })
      } catch {
        errorMessage.textContent =
          "Your message couldn't be sent. Please try again or email hello@aleksa.codes."
        errorMessage.classList.remove("hidden")
      } finally {
        submit.disabled = false
        submitLabel.textContent = "Send message"
        form.removeAttribute("aria-busy")
      }
    })
    form.addEventListener("reset", resetCaptcha)
    document.getElementById("send-another")?.addEventListener("click", () => {
      successMessage.classList.replace("flex", "hidden")
      form.classList.remove("hidden")
      errorMessage.classList.add("hidden")
      document.getElementById("name")?.focus()
    })
  }
</script>
