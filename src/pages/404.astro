---
import BaseLayout from "@/layouts/base-layout.astro"
import Button from "@/components/ui/button.astro"
import { Icon } from "astro-icon/components"
---

<BaseLayout title="404 - Page Not Found">
  <section class="flex grow flex-col items-center justify-center text-center">
    <div class="relative flex flex-col items-center justify-center">
      <div
        class="absolute inset-0 -z-10 m-auto h-50 w-50 rounded-full bg-primary/20 blur-[80px]"
      >
      </div>

      <h1
        class="text-[8rem] leading-none font-bold tracking-tighter sm:text-[12rem]"
      >
        <span
          class="bg-linear-to-b from-foreground to-muted-foreground/30 bg-clip-text text-transparent drop-shadow-sm"
        >
          404
        </span>
      </h1>
      <h2
        class="mt-4 text-2xl font-semibold tracking-tight text-foreground sm:text-3xl"
      >
        Page not found
      </h2>
      <p class="mt-4 max-w-75 text-base text-muted-foreground sm:max-w-md">
        The page you are looking for doesn't exist or has been moved.
      </p>
      <div class="mt-8">
        <Button href="/" size="xl" class="px-6">
          <Icon
            name="lucide:arrow-left"
            class="transition-transform duration-300 group-hover/button:-translate-x-1"
          />
          Back to home
        </Button>
      </div>
    </div>
  </section>
</BaseLayout>
