---
import BaseLayout from "@/layouts/base-layout.astro"
import { Icon } from "astro-icon/components"
import ProjectCard from "@/components/project-card.astro"
import Button from "@/components/ui/button.astro"
import { projects } from "@/lib/projects"

const title = "Projects"
const description =
  "Browse my portfolio of web development projects, including side projects and open source contributions built with modern tools and best practices."
const ogImage = new URL("/open-graph/projects.png", Astro.site).toString()
---

<BaseLayout {title} {description} {ogImage}>
  <div class="flex flex-col gap-12">
    <div class="flex flex-col items-start">
      <h1 class="mb-3 text-3xl font-bold tracking-tighter text-foreground md:text-4xl">
        <span class="bg-linear-to-r from-foreground to-muted-foreground bg-clip-text text-transparent">
          Projects.
        </span>
      </h1>
      <p class="max-w-xl text-base leading-relaxed text-pretty text-muted-foreground">
        A showcase of my open-source tools, websites, web apps, and experiments.
        I love building things that solve real problems or make the web a bit
        more fun.
      </p>
    </div>

    <div class="grid gap-x-10 gap-y-12 md:grid-cols-2 md:gap-y-16">
      {projects.map((project, index) => (
        <ProjectCard project={project} priority={index < 2} headingTag="h2" />
      ))}
    </div>

    <div class="flex justify-center">
      <Button
        variant="outline"
        size="xl"
        href="https://github.com/aleksa-codes"
        target="_blank"
        rel="noopener noreferrer"
        class="h-11 gap-2.5 px-5 text-base transition-colors hover:border-foreground/20 motion-reduce:transition-none"
      >
        <Icon name="lucide:github" class="size-5" />
        More on GitHub
        <Icon
          name="lucide:arrow-up-right"
          class="size-4 text-muted-foreground"
        />
      </Button>
    </div>
  </div>
</BaseLayout>
