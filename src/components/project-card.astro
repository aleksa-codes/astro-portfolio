---
import { Icon } from "astro-icon/components"
import { Image } from "astro:assets"
import Badge from "@/components/ui/badge.astro"
import Button from "@/components/ui/button.astro"
import Card from "@/components/ui/card.astro"
import { techMap } from "@/lib/tech"
import { cn } from "@/lib/utils"
import type { projects } from "@/lib/projects"

interface Props {
  project: (typeof projects)[number]
  alternate?: boolean
  priority?: boolean
}

const { project, alternate = false, priority = false }: Props = Astro.props
---

<Card
  class="group p-4 transition-all duration-300"
  contentClass={cn(
    "flex flex-col gap-4 md:flex-row md:items-center",
    alternate && "md:flex-row-reverse"
  )}
>
  <a
    href={project.demo ||
      project.github ||
      project.huggingface ||
      project.replicate ||
      "#"}
    target="_blank"
    rel="noopener noreferrer"
    class="group relative w-full min-w-0 flex-1 overflow-hidden rounded-xl border border-border/50"
  >
    <Image
      src={project.image}
      alt={project.title}
      format={"webp"}
      quality={70}
      widths={[384, 576, 768, 1024]}
      sizes="(min-width: 768px) 384px, calc(100vw - 4rem)"
      priority={priority}
      class="h-auto w-full object-cover transition-transform duration-700 group-hover:scale-[1.02]"
    />
  </a>

  <div class="flex w-full min-w-0 flex-1 flex-col justify-center">
    <div class="flex flex-col">
      <span
        class="text-xs font-bold tracking-widest text-muted-foreground/80 uppercase"
      >
        {project.category}
      </span>
      <h3 class="text-2xl font-bold tracking-tight text-foreground">
        {project.title}
      </h3>
    </div>

    <div class="mt-2 flex flex-wrap items-center gap-2">
      {
        project.tags.map((tag) => {
          const key = tag.toLowerCase()
          const info = techMap[key]
          return (
            <Badge
              variant="secondary"
              size="lg"
              class="group-hover:border-foreground/10"
            >
              <Icon
                name={info ? info.icon : "lucide:tag"}
                class={cn(info ? info.color : "text-muted-foreground")}
              />
              <span>{tag}</span>
            </Badge>
          )
        })
      }
    </div>

    <p
      class="mt-4 line-clamp-4 text-base leading-relaxed text-muted-foreground"
      set:html={project.description}
    />

    <div class="mt-4 flex flex-wrap items-center gap-2">
      {
        project.github && (
          <Button
            variant="outline"
            size="lg"
            href={project.github}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={`View ${project.title} source code`}
          >
            <Icon name="lucide:github" />
            <span>Code</span>
          </Button>
        )
      }
      {
        project.demo && (
          <Button
            variant="outline"
            size="lg"
            href={project.demo}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={`Visit ${project.title}`}
          >
            <Icon name="lucide:external-link" />
            <span>Demo</span>
          </Button>
        )
      }
      {
        project.huggingface && (
          <Button
            variant="outline"
            size="lg"
            href={project.huggingface}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="View on HuggingFace"
          >
            <Icon name="simple-icons:huggingface" />
            <span>HuggingFace</span>
          </Button>
        )
      }
      {
        project.replicate && (
          <Button
            variant="outline"
            size="lg"
            href={project.replicate}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="View on Replicate"
          >
            <Icon name="simple-icons:replicate" />
            <span>Replicate</span>
          </Button>
        )
      }
    </div>
  </div>
</Card>
