---
import { Icon } from "astro-icon/components"
import Button from "@/components/ui/button.astro"

// Shared shape for the chunky chat chips (initial suggestions + follow-ups)
const suggestionClass =
  "h-auto w-fit gap-3 rounded-2xl bg-card px-5 py-3 text-left whitespace-normal shadow-sm [&_svg:not([class*=size-])]:size-5"

const followUpClass =
  "h-auto w-fit gap-2 rounded-xl bg-card px-4 py-2 text-left whitespace-normal shadow-sm"

const suggestions = [
  {
    prompt: "What are your main projects?",
    icon: "lucide:folder",
    iconClass: "text-yellow-500",
  },
  {
    prompt: "What technologies do you use?",
    icon: "lucide:code-2",
    iconClass: "text-blue-500",
  },
  {
    prompt: "How can I contact you?",
    icon: "lucide:mail",
    iconClass: "text-emerald-500",
  },
]
---

<div data-nosnippet>
  <!-- Modal Overlay -->
  <div
    id="chat-overlay"
    class="pointer-events-none fixed inset-0 z-100 flex items-center justify-center bg-black/40 p-0 opacity-0 backdrop-blur-sm transition-opacity duration-300 md:p-6 dark:bg-black/80"
  >
    <!-- Chat Window -->
    <div
      id="chat-window"
      class="flex h-dvh w-full scale-95 transform flex-col overflow-hidden rounded-none border-0 border-border bg-card opacity-0 shadow-2xl transition-all duration-300 md:h-[75vh] md:max-h-175 md:max-w-2xl md:rounded-3xl md:border"
    >
      <!-- Header -->
      <div
        class="flex items-center justify-between border-b border-border bg-muted/30 p-4"
      >
        <div class="flex items-center gap-2">
          <div
            class="flex size-9 items-center justify-center rounded-xl bg-foreground text-background shadow-sm"
          >
            <Icon name="lucide:bot-message-square" class="h-5 w-5" />
          </div>
          <div class="flex h-8 flex-col justify-center gap-0.5">
            <div class="text-base leading-none font-semibold text-foreground">
              Portfolio AI
            </div>
            <div class="text-sm font-medium text-muted-foreground">
              Built by Aleksa. Powered by Groq.
            </div>
          </div>
        </div>
        <div class="flex items-center gap-2">
          <Button
            id="clear-chat-btn"
            variant="ghost"
            size="icon-xl"
            class="hidden text-muted-foreground hover:text-destructive"
            aria-label="Clear conversation"
            title="Clear conversation"
          >
            <Icon name="lucide:trash-2" />
          </Button>
          <Button
            id="chat-close-btn"
            variant="ghost"
            size="icon-xl"
            class="text-muted-foreground"
            aria-label="Close chat"
          >
            <Icon name="lucide:x" />
          </Button>
        </div>
      </div>

      <!-- Messages Area -->
      <div
        id="chat-messages"
        class="flex-1 scrollbar-thin [scrollbar-color:var(--color-muted-foreground)_transparent] space-y-6 overflow-y-auto p-4 [&::-webkit-scrollbar]:w-1.5 [&::-webkit-scrollbar-thumb]:rounded-full [&::-webkit-scrollbar-thumb]:bg-muted-foreground/20 [&::-webkit-scrollbar-thumb:hover]:[background:var(--color-muted-foreground)] [&::-webkit-scrollbar-track]:bg-transparent"
      >
        <!-- Initial Message -->
        <div class="flex max-w-[90%] flex-col gap-2 md:max-w-[85%]">
          <div class="mb-1 flex items-center gap-2">
            <Icon
              name="lucide:bot-message-square"
              class="h-4 w-4 text-muted-foreground"
            />
            <span
              class="text-sm font-semibold tracking-wider text-muted-foreground uppercase"
              >Assistant</span
            >
          </div>
          <div
            class="rounded-3xl rounded-tl-sm border border-border/40 bg-muted px-5 py-4 text-base leading-relaxed wrap-break-word text-foreground shadow-sm [&_a]:break-all"
          >
            Hello! I'm Aleksa's portfolio AI. I know all about his engineering
            experience, tech stack, and projects. What would you like to know?
          </div>
        </div>

        <!-- Initial Suggestions -->
        <div id="chat-suggestions" class="mt-5 flex flex-col gap-3">
          {
            suggestions.map(({ prompt, icon, iconClass }) => (
              <Button
                variant="outline"
                data-prompt={prompt}
                class={suggestionClass}
              >
                <Icon name={icon} class={iconClass} />
                {prompt}
              </Button>
            ))
          }
        </div>

        <!-- Markup source for the follow-up chips rendered by the script -->
        <template id="follow-up-template">
          <Button variant="outline" class={followUpClass}>
            <Icon name="lucide:arrow-right" class="text-primary" />
            <span></span>
          </Button>
        </template>
      </div>

      <!-- Footer/Input -->
      <div class="border-t border-border bg-card p-4">
        <form id="chat-form" class="relative flex items-center">
          <input
            type="text"
            id="chat-input"
            placeholder="Ask about Aleksa..."
            autocomplete="off"
            class="w-full rounded-2xl border border-border bg-muted/50 py-4 pr-14 pl-5 text-base text-foreground shadow-inner transition-all placeholder:text-muted-foreground focus:border-primary/50 focus:outline-none disabled:cursor-not-allowed disabled:opacity-50"
          />
          <Button
            type="submit"
            id="submit-button"
            size="icon-xl"
            aria-label="Send message"
            class="absolute right-3 disabled:cursor-not-allowed"
          >
            <Icon name="lucide:send" id="send-icon" />
            <Icon
              name="lucide:loader-circle"
              id="loading-icon"
              class="hidden animate-spin"
            />
          </Button>
        </form>
        <div
          class="mt-3 flex items-center justify-between text-sm text-muted-foreground"
        >
          <span id="message-counter">0/5 today</span>
          <span>AI can make mistakes.</span>
        </div>
      </div>
    </div>
  </div>
</div>
