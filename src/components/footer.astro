<footer
  class="flex cursor-default flex-col items-center justify-center gap-21.5 xs:gap-23.5 md:gap-24.5"
>
  <svg
    aria-hidden="true"
    class="w-90 font-signature text-7xl text-muted-foreground xs:w-100 sm:w-105 md:w-110"
    xmlns="http://www.w3.org/2000/svg"
    viewBox="0 0 440 72"
  >
    <text x="220" y="64" text-anchor="middle" fill="currentColor">
      aleksa.codes
    </text>
  </svg>
  <p class="text-sm leading-6 font-medium text-muted-foreground">
    © <span id="current-year">2026</span> · Have a great <span id="current-day"
      >Friday</span
    >
  </p>
</footer>

<script>
  const yearEl = document.getElementById("current-year")
  const dayEl = document.getElementById("current-day")
  if (yearEl) yearEl.textContent = new Date().getFullYear().toString()
  if (dayEl)
    dayEl.textContent = new Date().toLocaleDateString("en-US", {
      weekday: "long",
    })

  // The signature font (25 KiB) is only used by the footer, below the fold.
  // Inject its @font-face rule lazily when the footer nears the viewport so
  // the font request stays out of the critical path. Falls back to loading
  // immediately for browsers without IntersectionObserver.
  const signatureEl = document.querySelector<HTMLElement>(".font-signature")
  if (signatureEl) {
    const loadSignatureFont = () => {
      const style = document.createElement("style")
      style.textContent =
        '@font-face{font-family:"Dancing Script";src:url("/fonts/DancingScript-700.woff2") format("woff2");font-weight:700;font-display:swap;font-style:normal}'
      document.head.appendChild(style)

      document.fonts?.load('700 1em "Dancing Script"').then(
        () => {
          // Force the already-painted SVG text to re-layout with the font
          signatureEl.style.fontFamily = "inherit"
          void signatureEl.getBoundingClientRect()
          signatureEl.style.fontFamily = ""
        },
        () => {}
      )
    }

    if ("IntersectionObserver" in window) {
      const observer = new IntersectionObserver(
        (entries) => {
          if (entries.some((e) => e.isIntersecting)) {
            observer.disconnect()
            loadSignatureFont()
          }
        },
        { rootMargin: "600px 0px" }
      )
      observer.observe(signatureEl)
    } else {
      loadSignatureFont()
    }
  }
</script>
