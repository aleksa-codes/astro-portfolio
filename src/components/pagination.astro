---
import Button from "@/components/ui/button.astro"
import { Icon } from "astro-icon/components"

interface Props {
  currentPage: number
  lastPage: number
  urlPrev: string | undefined
  urlNext: string | undefined
  basePath: string
}

const { currentPage, lastPage, urlPrev, urlNext, basePath } = Astro.props

// Generate page numbers to show
const pages = []
for (let i = 1; i <= lastPage; i++) {
  pages.push(i)
}
---

<nav
  class="grid grid-cols-[1fr_auto_1fr] items-center gap-2 border-t border-border pt-6"
  aria-label="Pagination"
>
  <Button
    variant="ghost"
    size="xl"
    href={urlPrev === "/blog/1" ? "/blog" : urlPrev}
    disabled={!urlPrev}
    aria-label="Previous Page"
    class="h-11 justify-self-start gap-1.5 rounded-lg px-2 text-sm"
  >
    <Icon name="lucide:chevron-left" class="size-4" />
    Previous
  </Button>

  <div class="flex items-center gap-1">
    {pages.map((page) => {
      const isCurrent = page === currentPage
      const href = page === 1 ? basePath : `${basePath}/${page}`
      return (
        <Button
          variant={isCurrent ? "default" : "ghost"}
          size="icon-xl"
          href={href}
          class="size-11 rounded-lg text-sm tabular-nums"
          aria-label={`Page ${page}`}
          aria-current={isCurrent ? "page" : undefined}
        >
          {page}
        </Button>
      )
    })}
  </div>

  <Button
    variant="ghost"
    size="xl"
    href={urlNext}
    disabled={!urlNext}
    aria-label="Next Page"
    class="h-11 justify-self-end gap-1.5 rounded-lg px-2 text-sm"
  >
    Next
    <Icon name="lucide:chevron-right" class="size-4" />
  </Button>
</nav>
