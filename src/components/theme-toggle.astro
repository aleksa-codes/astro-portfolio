---
import { Icon } from "astro-icon/components"
import Button from "@/components/ui/button.astro"
import Tooltip from "@/components/ui/tooltip.astro"
---

<Tooltip content="Toggle Theme" side="bottom">
  <Button
    variant="ghost"
    size="icon-xl"
    aria-label="Toggle theme"
    class="theme-toggle text-muted-foreground"
  >
    <Icon name="lucide:sun" class="hidden dark:block" />
    <Icon name="lucide:moon" class="block dark:hidden" />
  </Button>
</Tooltip>

<script>
  document.addEventListener("click", (e) => {
    if (!(e.target as HTMLElement).closest(".theme-toggle")) return

    const doc = document.documentElement

    // Disable transitions temporarily
    doc.classList.add("[&_*]:!transition-none")

    // Toggle theme & save
    const isDark = doc.classList.toggle("dark")
    localStorage.setItem("theme", isDark ? "dark" : "light")

    // Force DOM repaint
    doc.offsetHeight

    // Re-enable transitions
    requestAnimationFrame(() => doc.classList.remove("[&_*]:!transition-none"))
  })
</script>
