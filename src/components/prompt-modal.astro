---
import { Icon } from "astro-icon/components"
import Badge from "@/components/ui/badge.astro"
import Button from "@/components/ui/button.astro"
import { games, getModelBadge } from "@/lib/games"

// One badge per model, rendered up front so the script can clone the real
// Badge markup instead of rebuilding it by hand
const models = [...new Set(games.map((game) => game.model))]
---

<div
  id="prompt-modal"
  class="fixed inset-0 z-100 hidden items-center justify-center bg-background/70 p-4 backdrop-blur-md"
  role="dialog"
  aria-modal="true"
  aria-labelledby="prompt-modal-title"
>
  <div
    id="prompt-modal-panel"
    class="flex max-h-[85dvh] w-full max-w-xl flex-col overflow-hidden rounded-2xl border border-border bg-card shadow-2xl"
  >
    <!-- Header -->
    <div class="flex items-center gap-3 border-b border-border px-4 py-3">
      <div class="flex min-w-0 flex-1 items-center gap-2">
        <h2
          id="prompt-modal-title"
          class="truncate text-base font-semibold text-foreground"
        >
        </h2>
        <span id="prompt-modal-model" class="contents"></span>
      </div>
      <Button
        id="prompt-modal-close"
        variant="ghost"
        size="icon-lg"
        title="Close (Esc)"
        aria-label="Close"
        class="-mr-1 text-muted-foreground"
      >
        <Icon name="lucide:x" />
      </Button>
    </div>

    <!-- Prompt body -->
    <div class="min-h-0 flex-1 overflow-y-auto px-4 py-4">
      <p
        id="prompt-modal-text"
        class="font-mono text-xs leading-relaxed whitespace-pre-wrap text-muted-foreground sm:text-[13px]"
      >
      </p>
    </div>

    <!-- Footer -->
    <div class="flex justify-end border-t border-border px-4 py-3">
      <Button id="prompt-modal-copy" variant="outline" size="lg">
        <Icon name="lucide:copy" />
        <span id="prompt-modal-copy-label">Copy prompt</span>
      </Button>
    </div>
  </div>

  {
    models.map((model) => (
      <template data-model-badge={model}>
        <Badge variant="secondary" size="lg" class="shrink-0">
          <Icon
            name={getModelBadge(model).icon}
            style={`color: ${getModelBadge(model).color};`}
          />
          {model}
        </Badge>
      </template>
    ))
  }
</div>

<script>
  const modal = document.getElementById("prompt-modal")!
  const panel = document.getElementById("prompt-modal-panel")!
  const titleEl = document.getElementById("prompt-modal-title")!
  const modelEl = document.getElementById("prompt-modal-model")!
  const textEl = document.getElementById("prompt-modal-text")!
  const copyBtn = document.getElementById("prompt-modal-copy")!
  const copyLabel = document.getElementById("prompt-modal-copy-label")!

  let open = false
  let current = ""

  const badgeTemplates = Array.from(
    modal.querySelectorAll<HTMLTemplateElement>("template[data-model-badge]")
  )

  function setModel(model: string) {
    const template = badgeTemplates.find((t) => t.dataset.modelBadge === model)
    if (template?.content.firstElementChild) {
      modelEl.replaceChildren(
        template.content.firstElementChild.cloneNode(true)
      )
    } else {
      modelEl.textContent = model
    }
  }

  function show(btn: HTMLElement) {
    current = btn.dataset.prompt ?? ""
    titleEl.textContent = btn.dataset.promptTitle ?? ""
    setModel(btn.dataset.promptModel ?? "")
    textEl.textContent = current
    copyLabel.textContent = "Copy prompt"
    modal.classList.remove("hidden")
    modal.classList.add("flex")
    document.body.style.overflow = "hidden"
    open = true
    copyBtn.focus()
  }

  function hide() {
    if (!open) return
    modal.classList.add("hidden")
    modal.classList.remove("flex")
    document.body.style.overflow = ""
    open = false
  }

  document
    .querySelectorAll<HTMLElement>("[data-prompt-open]")
    .forEach((btn) => btn.addEventListener("click", () => show(btn)))

  document.getElementById("prompt-modal-close")!.addEventListener("click", hide)

  // click outside the panel closes
  modal.addEventListener("click", (e) => {
    if (!panel.contains(e.target as Node)) hide()
  })

  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && open) hide()
  })

  copyBtn.addEventListener("click", async () => {
    await navigator.clipboard.writeText(current)
    copyLabel.textContent = "Copied!"
    setTimeout(() => (copyLabel.textContent = "Copy prompt"), 1500)
  })
</script>
