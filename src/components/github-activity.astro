---
import { Icon } from "astro-icon/components"

interface Props {
  username?: string
}

const { username = "aleksa-codes" } = Astro.props

let totalStars = 0,
  followers = 0,
  publicRepos = 0,
  fetchError = false

try {
  const [userRes, reposRes] = await Promise.all([
    fetch(`https://api.github.com/users/${username}`),
    fetch(`https://api.github.com/users/${username}/repos?per_page=100`),
  ])
  if (!userRes.ok || !reposRes.ok) throw new Error()

  const userData = await userRes.json()
  const reposData = await reposRes.json()

  followers = userData.followers
  publicRepos = userData.public_repos
  totalStars = reposData.reduce(
    (acc: number, repo: any) => acc + repo.stargazers_count,
    0
  )
} catch (e) {
  fetchError = true
}
---

<div class="flex min-h-0 w-full flex-1 flex-col justify-center gap-2 p-4">
  <div id="gh-labels" class="flex w-full gap-0.75">
    {
      Array.from({ length: 22 }).map(() => (
        <span class="min-w-0 flex-1 text-xs font-medium text-muted-foreground">
          &nbsp;
        </span>
      ))
    }
  </div>
  <div id="gh-graph" data-username={username} class="flex w-full gap-0.75">
    {
      Array.from({ length: 22 }).map(() => (
        <div class="flex min-w-0 flex-1 flex-col gap-0.75">
          {Array.from({ length: 7 }).map(() => (
            <div class="aspect-square w-full animate-pulse rounded-[2px] bg-secondary/60" />
          ))}
        </div>
      ))
    }
  </div>
  <p id="gh-error" class="hidden text-center text-xs text-muted-foreground/60">
    Could not load contribution data
  </p>
  <a
    href="https://github.com/aleksa-codes"
    target="_blank"
    rel="noopener noreferrer"
    class="self-center text-xs whitespace-nowrap text-muted-foreground underline underline-offset-2 hover:text-foreground"
  >
    github.com/aleksa-codes
  </a>
</div>

<div
  class="flex shrink-0 flex-wrap items-center justify-center gap-x-3 gap-y-2 border-t border-border/60 px-4 py-3"
>
  {
    fetchError ? (
      <p class="text-sm text-red-500/80">Failed to load stats.</p>
    ) : (
      <>
        <div class="flex min-w-0 items-center gap-1.5">
          <Icon name="lucide:star" class="h-4 w-4 text-muted-foreground/70" />
          <span class="text-sm font-semibold text-foreground">
            {totalStars}
          </span>
          <span class="text-[11px] font-semibold tracking-widest text-muted-foreground uppercase">
            Stars
          </span>
        </div>
        <div class="flex min-w-0 items-center gap-1.5">
          <Icon name="lucide:users" class="h-4 w-4 text-muted-foreground/70" />
          <span class="text-sm font-semibold text-foreground">{followers}</span>
          <span class="text-[11px] font-semibold tracking-widest text-muted-foreground uppercase">
            Followers
          </span>
        </div>
        <div class="flex min-w-0 items-center gap-1.5">
          <Icon name="lucide:book" class="h-4 w-4 text-muted-foreground/70" />
          <span class="text-sm font-semibold text-foreground">
            {publicRepos}
          </span>
          <span class="text-[11px] font-semibold tracking-widest text-muted-foreground uppercase">
            Repos
          </span>
        </div>
      </>
    )
  }
</div>

<script>
  ;(async () => {
    const graphEl = document.getElementById("gh-graph")
    if (!graphEl) return

    const username = graphEl.dataset.username
    const months = [
      "Jan",
      "Feb",
      "Mar",
      "Apr",
      "May",
      "Jun",
      "Jul",
      "Aug",
      "Sep",
      "Oct",
      "Nov",
      "Dec",
    ]

    // IMPORTANT: These must be written out fully so Tailwind scanner finds them
    const colors = [
      "bg-[var(--gh-0)]",
      "bg-[var(--gh-1)]",
      "bg-[var(--gh-2)]",
      "bg-[var(--gh-3)]",
      "bg-[var(--gh-4)]",
    ]

    try {
      const res = await fetch(
        `https://github-contributions-api.jogruber.de/v4/${username}?y=last`
      )
      if (!res.ok) throw new Error()
      const { contributions } = await res.json()
      // O(1) performance lookup
      const contribMap = new Map<string, number>(
        contributions.map((c: any) => [c.date, c.count])
      )

      const cols = 22,
        rows = 7
      const today = new Date()
      const start = new Date(
        today.setDate(today.getDate() - today.getDay() - (cols - 1) * 7)
      )

      let labelsHtml = "",
        graphHtml = "",
        lastMonth = -1

      for (let i = 0; i < cols; i++) {
        const colDate = new Date(start)
        colDate.setDate(start.getDate() + i * 7)
        const m = colDate.getMonth()

        labelsHtml += `<span class="min-w-0 flex-1 text-center text-xs font-medium text-muted-foreground">${m !== lastMonth ? months[m] : "&nbsp;"}</span>`
        lastMonth = m

        graphHtml += `<div class="flex min-w-0 flex-1 flex-col gap-0.75">`
        for (let j = 0; j < rows; j++) {
          const d = new Date(colDate)
          d.setDate(d.getDate() + j)

          const count = contribMap.get(d.toISOString().split("T")[0]) || 0
          const int =
            count === 0
              ? 0
              : count <= 2
                ? 1
                : count <= 5
                  ? 2
                  : count <= 10
                    ? 3
                    : 4
          const label = `${count} contributions on ${months[d.getMonth()]} ${d.getDate()}`

          graphHtml += `<div class="contribution-cell aspect-square w-full rounded-[2px] ${colors[int]} transition-colors" data-tooltip="${label}"></div>`
        }
        graphHtml += `</div>`
      }

      document.getElementById("gh-labels")!.innerHTML = labelsHtml
      graphEl.innerHTML = graphHtml

      const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches
      const cells: HTMLElement[] = []

      // Keep the freshly-rendered graph invisible until the wipe starts, so
      // the full contribution map never flashes in before it animates.
      if (!reduced) {
        graphEl
          .querySelectorAll<HTMLElement>(":scope > div > div")
          .forEach((cell) => {
            cells.push(cell)
            cell.style.opacity = "0"
            cell.style.transform = "scale(0.4)"
          })
      }

      // Wait for the graph to scroll into view before animating,
      // so users actually see the columns wipe in
      const inView = () =>
        new Promise<boolean>((resolve) => {
          const io = new IntersectionObserver(
            (entries) => {
              if (entries.some((e) => e.isIntersecting)) {
                io.disconnect()
                resolve(true)
              }
            },
            { threshold: 0.3 }
          )
          io.observe(graphEl)
        })

      const animate = !reduced && (await inView())

      if (animate) {
        // Cells cascade in with a subtle scale, Apple-style ease-out
        graphEl
          .querySelectorAll<HTMLElement>(":scope > div")
          .forEach((col, ci) => {
            col
              .querySelectorAll<HTMLElement>(":scope > div")
              .forEach((cell, ri) => {
                cell.animate(
                  [
                    { opacity: "0", transform: "scale(0.4)" },
                    { opacity: "1", transform: "scale(1)" },
                  ],
                  {
                    duration: 340,
                    delay: ci * 15 + ri * 7,
                    easing: "cubic-bezier(0.16, 1, 0.3, 1)",
                    fill: "backwards",
                  }
                )
              })
          })
        // The running animation now owns opacity/scale; release the hold so the
        // graph stays visible once every cell has finished wiping in
        cells.forEach((c) => {
          c.style.opacity = ""
          c.style.transform = ""
        })
      }

      // Tooltip Delegation Logic
      let tooltip = document.getElementById("gh-tooltip")
      if (!tooltip) {
        document.body.insertAdjacentHTML(
          "beforeend",
          `<div id="gh-tooltip" class="pointer-events-none fixed z-[100] whitespace-nowrap rounded-lg bg-primary px-3 py-1.5 text-xs font-medium text-primary-foreground opacity-0 shadow-md transition-opacity duration-200 flex flex-col items-center justify-center"><div class="absolute top-full left-1/2 -translate-x-1/2 h-0 w-0 border-4 border-transparent border-t-primary"></div><span id="gh-tooltip-content"></span></div>`
        )
        tooltip = document.getElementById("gh-tooltip")!
      }
      const content = document.getElementById("gh-tooltip-content")!

      graphEl.addEventListener("mouseover", (e) => {
        const cell = (e.target as HTMLElement).closest(
          ".contribution-cell"
        ) as HTMLElement
        if (!cell) return (tooltip!.style.opacity = "0")

        content.textContent = cell.dataset.tooltip!
        tooltip!.style.opacity = "1"
        const rect = cell.getBoundingClientRect()
        tooltip!.style.left = `${rect.left + rect.width / 2 - tooltip!.offsetWidth / 2}px`
        tooltip!.style.top = `${rect.top - tooltip!.offsetHeight - 8}px`
      })

      graphEl.addEventListener(
        "mouseleave",
        () => (tooltip!.style.opacity = "0")
      )
    } catch {
      document.getElementById("gh-error")?.classList.remove("hidden")
    }
  })()
</script>
