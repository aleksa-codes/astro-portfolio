---
import { Icon } from "astro-icon/components"
import { cn } from "@/lib/utils"

interface Props {
  username?: string
}

const { username = "aleksa-codes" } = Astro.props

let totalStars = 0,
  followers = 0,
  publicRepos = 0,
  fetchError = false

try {
  const [userRes, reposRes] = await Promise.all([
    fetch(`https://api.github.com/users/${username}`),
    fetch(`https://api.github.com/users/${username}/repos?per_page=100`),
  ])
  if (!userRes.ok || !reposRes.ok) throw new Error()

  const userData = await userRes.json()
  const reposData = await reposRes.json()

  followers = userData.followers
  publicRepos = userData.public_repos
  totalStars = reposData.reduce(
    (acc: number, repo: any) => acc + repo.stargazers_count,
    0
  )
} catch (e) {
  fetchError = true
}
---

<div class="flex h-full flex-col gap-3">
  <div class="flex items-center justify-between gap-3">
    <a
      href={`https://github.com/${username}`}
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex w-fit items-center gap-2 rounded-sm text-sm text-foreground underline-offset-4 hover:underline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-ring"
    >
      <Icon name="lucide:github" class="size-4" />
      {username}
      <Icon
        name="lucide:arrow-up-right"
        class="size-3.5 text-muted-foreground"
      />
    </a>
  </div>

  <div id="gh-calendar-scroll">
    <div id="gh-calendar" class="flex min-w-0 flex-col gap-2">
      <div id="gh-labels" class="relative h-5 w-full"></div>
      <div
        id="gh-graph"
        data-username={username}
        role="img"
        aria-label="GitHub contribution activity"
        class="flex w-full gap-0.75"
      >
        {Array.from({ length: 26 }).map(() => (
          <div class="flex min-w-0 flex-1 flex-col gap-0.75">
            {Array.from({ length: 7 }).map(() => (
              <div class="aspect-square w-full rounded-[2px] bg-secondary/60" />
            ))}
          </div>
        ))}
      </div>
    </div>
  </div>
  <p id="gh-error" class="hidden text-sm text-muted-foreground">
    Contribution data is unavailable. View activity on GitHub.
  </p>
  <div
    id="gh-legend"
    class="flex items-center justify-between gap-4 text-sm text-muted-foreground"
  >
    <span>Past six months</span>
    <div class="flex items-center gap-1.5" aria-hidden="true">
      <span class="mr-1">Less</span>
      {[
        "bg-[var(--gh-0)]",
        "bg-[var(--gh-1)]",
        "bg-[var(--gh-2)]",
        "bg-[var(--gh-3)]",
        "bg-[var(--gh-4)]",
      ].map((color) => (
        <span class={cn("size-2.5 rounded-[2px]", color)} />
      ))}
      <span class="ml-1">More</span>
    </div>
  </div>
  <div
    id="gh-stats"
    class="mt-auto flex flex-wrap items-center justify-between gap-x-3 gap-y-2 pt-2 text-sm text-muted-foreground"
  >
    {fetchError ? (
      <p>Stats unavailable</p>
    ) : (
      <>
        <span class="inline-flex items-center gap-1.5">
          <Icon name="lucide:star" class="size-3.5" />
          <span class="text-base font-medium text-foreground tabular-nums">
            {totalStars}
          </span>
          Stars
        </span>
        <span class="inline-flex items-center gap-1.5">
          <Icon name="lucide:users" class="size-3.5" />
          <span class="text-base font-medium text-foreground tabular-nums">
            {followers}
          </span>
          Followers
        </span>
        <span class="inline-flex items-center gap-1.5">
          <Icon name="lucide:book" class="size-3.5" />
          <span class="text-base font-medium text-foreground tabular-nums">
            {publicRepos}
          </span>
          Repos
        </span>
      </>
    )}
  </div>
</div>

<script>
  ;(async () => {
    const graphEl = document.getElementById("gh-graph")
    if (!graphEl) return

    const username = graphEl.dataset.username
    const months = [
      "Jan",
      "Feb",
      "Mar",
      "Apr",
      "May",
      "Jun",
      "Jul",
      "Aug",
      "Sep",
      "Oct",
      "Nov",
      "Dec",
    ]

    // IMPORTANT: These must be written out fully so Tailwind scanner finds them
    const colors = [
      "bg-[var(--gh-0)]",
      "bg-[var(--gh-1)]",
      "bg-[var(--gh-2)]",
      "bg-[var(--gh-3)]",
      "bg-[var(--gh-4)]",
    ]

    try {
      const res = await fetch(
        `https://github-contributions-api.jogruber.de/v4/${username}?y=last`
      )
      if (!res.ok) throw new Error()
      const { contributions } = await res.json()
      // O(1) performance lookup
      const contribMap = new Map<string, number>(
        contributions.map((c: any) => [c.date, c.count])
      )

      const cols = 26,
        rows = 7
      const start = new Date()
      start.setDate(start.getDate() - start.getDay() - (cols - 1) * 7)

      let graphHtml = "",
        labelsHtml = "",
        lastMonth = -1,
        lastLabeled = -99

      for (let i = 0; i < cols; i++) {
        const colDate = new Date(start)
        colDate.setDate(start.getDate() + i * 7)

        // GitHub-style: pin each month over its first column, overlapping
        // freely instead of squeezing into the cell width.
        // Months starting too close together are skipped, like GitHub does.
        if (colDate.getMonth() !== lastMonth && i - lastLabeled >= 2) {
          lastMonth = colDate.getMonth()
          lastLabeled = i
          const atEnd = i > cols - 3
          const left = atEnd ? 100 : (i / cols) * 100
          labelsHtml += `<span class="absolute top-0 text-sm font-medium whitespace-nowrap text-muted-foreground" style="left:${left}%;${atEnd ? "transform:translateX(-100%);" : ""}">${months[lastMonth]}</span>`
        }

        graphHtml += `<div class="flex min-w-0 flex-1 flex-col gap-0.75">`
        for (let j = 0; j < rows; j++) {
          const d = new Date(colDate)
          d.setDate(d.getDate() + j)

          if (d > new Date()) {
            graphHtml += '<div class="aspect-square w-full"></div>'
            continue
          }
          const dateKey = `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, "0")}-${String(d.getDate()).padStart(2, "0")}`
          const count = contribMap.get(dateKey) || 0
          const int =
            count === 0
              ? 0
              : count <= 2
                ? 1
                : count <= 5
                  ? 2
                  : count <= 10
                    ? 3
                    : 4
          const label = `${count} contributions on ${months[d.getMonth()]} ${d.getDate()}`

          graphHtml += `<div class="contribution-cell aspect-square w-full rounded-[2px] ${colors[int]} transition-colors" data-tooltip="${label}"></div>`
        }
        graphHtml += `</div>`
      }

      document.getElementById("gh-labels")!.innerHTML = labelsHtml
      graphEl.innerHTML = graphHtml

      const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches
      const cells: HTMLElement[] = []
      const labelsEl = document.getElementById("gh-labels")
      const statsEl = document.getElementById("gh-stats")

      // Keep the freshly-rendered graph invisible until the wipe starts, so
      // the full contribution map never flashes in before it animates.
      if (!reduced) {
        graphEl
          .querySelectorAll<HTMLElement>(":scope > div > div")
          .forEach((cell) => {
            cells.push(cell)
            cell.style.opacity = "0"
            cell.style.transform = "scale(0.4)"
          })
        // Months and stats join the same reveal instead of popping in
        if (labelsEl) labelsEl.style.opacity = "0"
        if (statsEl) {
          statsEl.style.opacity = "0"
          statsEl.style.transform = "translateY(6px)"
        }
      }

      // Wait for the graph to scroll into view before animating,
      // so users actually see the columns wipe in
      const inView = () =>
        new Promise<boolean>((resolve) => {
          const io = new IntersectionObserver(
            (entries) => {
              if (entries.some((e) => e.isIntersecting)) {
                io.disconnect()
                resolve(true)
              }
            },
            { threshold: 0.3 }
          )
          io.observe(graphEl)
        })

      const animate = !reduced && (await inView())

      const wipe = () => {
        // Cells cascade in with a subtle scale, Apple-style ease-out
        graphEl
          .querySelectorAll<HTMLElement>(":scope > div")
          .forEach((col, ci) => {
            col
              .querySelectorAll<HTMLElement>(":scope > div")
              .forEach((cell, ri) => {
                cell.animate(
                  [
                    { opacity: "0", transform: "scale(0.4)" },
                    { opacity: "1", transform: "scale(1)" },
                  ],
                  {
                    duration: 340,
                    delay: ci * 15 + ri * 7,
                    easing: "cubic-bezier(0.16, 1, 0.3, 1)",
                    fill: "backwards",
                  }
                )
              })
          })
      }

      if (animate) {
        wipe()
        labelsEl?.animate([{ opacity: "0" }, { opacity: "1" }], {
          duration: 340,
          easing: "cubic-bezier(0.16, 1, 0.3, 1)",
          fill: "backwards",
        })
        statsEl?.animate(
          [
            { opacity: "0", transform: "translateY(6px)" },
            { opacity: "1", transform: "translateY(0)" },
          ],
          {
            duration: 420,
            delay: 150,
            easing: "cubic-bezier(0.16, 1, 0.3, 1)",
            fill: "backwards",
          }
        )
        // The running animations own opacity/transform; release the hold so
        // everything stays visible once finished
        cells.forEach((c) => {
          c.style.opacity = ""
          c.style.transform = ""
        })
        if (labelsEl) labelsEl.style.opacity = ""
        if (statsEl) {
          statsEl.style.opacity = ""
          statsEl.style.transform = ""
        }
      }

      // Tooltip Delegation Logic
      let tooltip = document.getElementById("gh-tooltip")
      if (!tooltip) {
        document.body.insertAdjacentHTML(
          "beforeend",
          `<div id="gh-tooltip" class="pointer-events-none fixed z-[100] whitespace-nowrap rounded-lg bg-primary px-3 py-1.5 text-sm font-medium text-primary-foreground opacity-0 shadow-md transition-opacity duration-200 flex flex-col items-center justify-center"><div class="absolute top-full left-1/2 -translate-x-1/2 h-0 w-0 border-4 border-transparent border-t-primary"></div><span id="gh-tooltip-content"></span></div>`
        )
        tooltip = document.getElementById("gh-tooltip")!
      }
      const content = document.getElementById("gh-tooltip-content")!

      graphEl.addEventListener("mouseover", (e) => {
        const cell = (e.target as HTMLElement).closest(
          ".contribution-cell"
        ) as HTMLElement
        if (!cell) return (tooltip!.style.opacity = "0")

        content.textContent = cell.dataset.tooltip!
        tooltip!.style.opacity = "1"
        const rect = cell.getBoundingClientRect()
        tooltip!.style.left = `${Math.max(8, Math.min(rect.left + rect.width / 2 - tooltip!.offsetWidth / 2, innerWidth - tooltip!.offsetWidth - 8))}px`
        tooltip!.style.top = `${rect.top - tooltip!.offsetHeight - 8}px`
      })

      graphEl.addEventListener(
        "mouseleave",
        () => (tooltip!.style.opacity = "0")
      )
    } catch {
      document.getElementById("gh-calendar-scroll")?.classList.add("hidden")
      document.getElementById("gh-legend")?.classList.add("hidden")
      document.getElementById("gh-error")?.classList.remove("hidden")
    }
  })()
</script>
