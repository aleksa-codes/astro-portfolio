---
import { Icon } from "astro-icon/components"
import GitHubActivity from "@/components/github-activity.astro"
import { cn } from "@/lib/utils"

// figlet -f "Standard" (true lowercase glyphs)
const ART_BANNER = [
  "        _      _                             _           ",
  "   __ _| | ___| | _____  __ _   ___ ___   __| | ___  ___ ",
  "  / _` | |/ _ \\ |/ / __|/ _` | / __/ _ \\ / _` |/ _ \\/ __|",
  " | (_| | |  __/   <\\__ \\ (_| || (_| (_) | (_| |  __/\\__ \\",
  "  \\__,_|_|\\___|_|\\_\\___/\\__,_(_)___\\___/ \\__,_|\\___||___/",
]

const interests = [
  {
    icon: "lucide:brain-circuit",
    text: "Building things with AI & code",
    color: "text-pink-500",
  },
  {
    icon: "iconoir:basketball",
    text: "Love hooping & watching NBA",
    color: "text-orange-500",
  },
  {
    // Not gamepad-2: that one is used by the dock, and astro-icon embeds an
    // icon's <symbol> only at its first usage on a page. This terminal wipes
    // its SSR rows on load, which would orphan the dock's shared <use>.
    icon: "lucide:gamepad",
    text: "Casual gamer in my free time",
    color: "text-blue-500",
  },
  {
    icon: "lucide:coffee",
    text: "Fueled by coffee & curiosity",
    color: "text-amber-700 dark:text-amber-500",
  },
]
---

<section id="about" class="flex flex-col space-y-8">
  <h2 class="text-sm font-medium tracking-widest text-muted-foreground uppercase">
    About Me
  </h2>

  <div class="space-y-5 text-base leading-relaxed text-foreground">
    <p>
      As soon as I got my first PC as a kid, I was basically glued to the
      screen. My start in web dev was building a forum for my Counter-Strike 1.6
      clan and hosting our own server. Once I started tinkering, the rabbit hole
      never ended.
    </p>
    <p>
      I went on to get a Bachelor's in Computer Science, but most of what I know
      came from late nights, side projects, and breaking things until they
      worked. Browser extensions, full-stack apps, portfolio sites, all kinds of
      stuff. Every project taught me something new.
    </p>
    <p>
      What keeps me going is making things that feel good to use. Not just
      functional, but fast, accessible, and built with care. If a page is slow
      or the UI feels clunky, it bugs me. So I try to make sure it doesn't.
    </p>
  </div>

  <div
    id="about-terminal"
    role="region"
    aria-label="Interactive terminal"
    class="scroll-mt-24 border-y border-border"
  >
    <div
      id="whoami-term"
      class="relative flex h-152 min-h-0 flex-col overflow-hidden font-mono text-base md:h-88"
    >
      <div
        id="term-output"
        class="flex min-h-0 flex-1 flex-col overflow-y-auto py-5"
      >
        <div class="flex items-center gap-3">
          <span
            class="w-4 shrink-0 text-green-600 select-none dark:text-green-400"
            aria-hidden="true"
          >
            $
          </span>
          <span class="text-foreground">whoami</span>
        </div>
        <div class="mt-4 grid gap-6 md:grid-cols-2 md:gap-10">
          <div class="flex min-w-0 flex-col">
            <pre
              class="text-[8px] leading-[1.2] whitespace-pre text-foreground md:text-[9px]"
              aria-hidden="true"
            >{ART_BANNER.join("\n")}</pre>
            <div class="mt-4 flex flex-col gap-2">
              {interests.map((item) => (
                <div class="flex items-center gap-3">
                  <Icon
                    name={item.icon}
                    class={cn("size-4 shrink-0", item.color)}
                    aria-hidden="true"
                  />
                  <span class="text-muted-foreground">{item.text}</span>
                </div>
              ))}
            </div>
            <div class="mt-auto pt-4">
              <a
                href="mailto:hello@aleksa.codes"
                class="rounded-sm text-sm text-muted-foreground underline decoration-border underline-offset-4 hover:text-foreground focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring"
              >
                hello@aleksa.codes
              </a>
            </div>
          </div>
          <aside
            id="gh-panel"
            aria-label="GitHub activity"
            class="min-w-0 border-t border-border pt-5 md:border-t-0 md:pt-0"
          >
            <GitHubActivity />
          </aside>
        </div>
      </div>
    </div>

    <div
      id="term-input-row"
      class="flex min-h-14 items-center gap-3 border-t border-border py-3 font-mono text-base focus-within:bg-muted/40"
    >
      <span
        class="w-4 shrink-0 text-green-600 select-none dark:text-green-400"
        aria-hidden="true"
      >
        $
      </span>
      <div class="relative flex min-h-6 min-w-0 flex-1 items-center">
        <span id="term-before" class="text-foreground"></span>
        <span
          id="term-cursor"
          class="h-4 w-1.75 shrink-0 rounded-[1px] bg-green-500/80"
          aria-hidden="true"
        ></span>
        <span id="term-after" class="text-foreground"></span>
        <span
          id="term-placeholder"
          class="pointer-events-none absolute left-0 text-muted-foreground select-none"
        >
          type 'help' to explore
        </span>
        <input
          id="term-input"
          type="text"
          autocomplete="off"
          autocapitalize="off"
          spellcheck="false"
          aria-label="Terminal command input"
          class="absolute inset-0 h-full w-full cursor-text bg-transparent text-base text-transparent caret-transparent outline-none"
        />
      </div>
      <span
        class="hidden items-center gap-4 text-sm text-muted-foreground select-none sm:flex"
        aria-hidden="true"
      >
        <span>↑↓ history</span>
        <span>↵ run</span>
      </span>
    </div>
  </div>
</section>

<style>
  /* Cursor is invisible until the input is focused, like a real terminal */
  #term-cursor {
    opacity: 0;
  }
  #term-cursor.blink-cursor {
    opacity: 1;
    animation: term-blink 1.2s step-end infinite;
  }
  @keyframes term-blink {
    50% {
      opacity: 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    #term-cursor.blink-cursor {
      animation: none;
      opacity: 1;
    }
  }
</style>

<script>
  import { runMatrix } from "../lib/terminal/matrix"
  import { runSnake } from "../lib/terminal/snake"
  import { runSystem } from "../lib/terminal/system"
  import { runTank } from "../lib/terminal/tank"
  import { runHack } from "../lib/terminal/hack"
  const termEl = document.getElementById("whoami-term")
  const outputEl = document.getElementById("term-output")
  const inputEl = document.getElementById(
    "term-input"
  ) as HTMLInputElement | null
  const beforeEl = document.getElementById("term-before")
  const afterEl = document.getElementById("term-after")
  const phEl = document.getElementById("term-placeholder")
  const cursorEl = document.getElementById("term-cursor")

  if (termEl && outputEl && inputEl && beforeEl && afterEl && phEl) {
    const term: HTMLElement = termEl
    const output: HTMLElement = outputEl
    const input: HTMLInputElement = inputEl
    const sleep = (ms: number) => new Promise((r) => setTimeout(r, ms))
    const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches
    const PROMPT = "w-4 shrink-0 text-green-600 dark:text-green-400 select-none"
    let busy = true // locked until the intro finishes

    const scroll = () => (output.scrollTop = output.scrollHeight)

    // The input is invisible; these spans mirror it with a block cursor
    const render = () => {
      const pos = input.selectionStart ?? input.value.length
      beforeEl.textContent = input.value.slice(0, pos)
      afterEl.textContent = input.value.slice(pos)
      phEl.style.display = input.value ? "none" : ""
    }

    const promptLine = (cmd: string) => {
      const div = document.createElement("div")
      div.className = "flex items-center gap-3 py-0.5"
      div.innerHTML = `<span class="${PROMPT}" aria-hidden="true">$</span>`
      const label = document.createElement("span")
      label.className = "text-foreground"
      label.textContent = cmd
      div.appendChild(label)
      output.appendChild(div)
      scroll()
    }

    const print = (text: string, cls = "text-muted-foreground") => {
      const div = document.createElement("div")
      div.className = `py-0.5 whitespace-pre-wrap ${cls}`
      div.textContent = text
      output.appendChild(div)
      scroll()
    }

    // Keep the live nodes so replays preserve GitHub data and event listeners.
    const introRows = Array.from(output.children)

    async function runIntro() {
      const rows = introRows
      output.replaceChildren(...rows)
      output.style.opacity = ""

      // Reduced motion: just show everything, no reveal
      if (reduced) return

      // Smooth Apple-style top-to-bottom reveal: staggered fade + slight rise
      const DURATION = 420
      const STAGGER = 75
      rows.forEach((row, i) => {
        if (!(row instanceof HTMLElement)) return
        row.animate(
          [
            { opacity: 0, transform: "translateY(6px)", filter: "blur(2px)" },
            { opacity: 1, transform: "translateY(0)", filter: "blur(0)" },
          ],
          {
            duration: DURATION,
            delay: i * STAGGER,
            easing: "cubic-bezier(0.16, 1, 0.3, 1)",
            fill: "backwards",
          }
        )
      })
      // Wait for the last row so the terminal unlocks after the reveal.
      // The activity panel stays put: it's always visible, never replayed.
      await sleep(DURATION + (rows.length - 1) * STAGGER)
      scroll()
    }

    const HELP_TEXT = [
      "available commands:",
      "  help    show this message",
      "  whoami  replay the intro",
      "  matrix  enter the matrix",
      "  snake   play snake",
      "  system  the solar system",
      "  tank    watch the fish",
      "  hack    look like a hacker",
      "  clear   clear the terminal",
    ].join("\n")

    async function runCommand(raw: string) {
      const cmd = raw.trim().toLowerCase()
      if (!cmd || busy) return
      busy = true
      const tooltip = document.getElementById("gh-tooltip")
      if (tooltip) tooltip.style.opacity = "0"
      promptLine(raw.trim())
      if (cmd === "help") {
        print(HELP_TEXT)
      } else if (cmd === "whoami") {
        output.innerHTML = ""
        await runIntro()
      } else if (cmd === "clear") {
        output.innerHTML = ""
      } else if (cmd === "matrix") {
        if (reduced) {
          print("wake up, neo...")
          print("(matrix disabled with reduced motion)")
        } else {
          await runMatrix({ term, input, render })
          print("knock, knock.")
        }
      } else if (cmd === "snake") {
        if (reduced) {
          print("no snakes here")
          print("(snake disabled with reduced motion)")
        } else {
          await runSnake({ term, input, render })
          print("hungry for more? type 'snake'")
        }
      } else if (cmd === "system") {
        if (reduced) {
          print("the planets hold still")
          print("(system disabled with reduced motion)")
        } else {
          await runSystem({ term, input, render })
          print("back on earth.")
        }
      } else if (cmd === "tank") {
        if (reduced) {
          print("the fish are shy")
          print("(tank disabled with reduced motion)")
        } else {
          await runTank({ term, input, render })
          print("glub.")
        }
      } else if (cmd === "hack") {
        if (reduced) {
          print("no hacking while you rest")
          print("(hack disabled with reduced motion)")
        } else {
          await runHack({ term, input, render })
          print("we're in.")
        }
      } else {
        print(`command not found: ${cmd} — try 'help'`, "text-red-500/80")
      }
      busy = false
    }

    // Command history, arrow keys like a real shell
    const history: string[] = []
    let histIdx = -1

    input.addEventListener("keydown", (e) => {
      // While a command or the matrix is running, keys belong to it
      if (busy) return
      if (e.key === "Enter") {
        const v = input.value
        if (v.trim()) {
          history.push(v)
          histIdx = -1
        }
        input.value = ""
        render()
        void runCommand(v)
      } else if (e.key === "ArrowUp" && history.length) {
        e.preventDefault()
        histIdx = Math.min(histIdx + 1, history.length - 1)
        input.value = history[history.length - 1 - histIdx] ?? ""
        render()
      } else if (e.key === "ArrowDown" && history.length) {
        e.preventDefault()
        histIdx = Math.max(histIdx - 1, -1)
        input.value =
          histIdx === -1 ? "" : history[history.length - 1 - histIdx]
        render()
      }
    })
    ;["input", "keyup", "click", "focus"].forEach((ev) =>
      input.addEventListener(ev, render)
    )
    render()

    // Cursor only exists while the terminal is focused, like a real one
    if (cursorEl) {
      input.addEventListener("focus", () =>
        cursorEl.classList.add("blink-cursor")
      )
      input.addEventListener("blur", () =>
        cursorEl.classList.remove("blink-cursor")
      )
    }

    // Click anywhere in the terminal focuses the input — but not while a
    // command runs, so the mobile keyboard never pops mid-game
    termEl.addEventListener("click", () => {
      if (busy) return
      if (!getSelection()?.toString()) input.focus()
    })
    // The input row lives outside the terminal pane (full width),
    // so it needs its own focus handler
    document.getElementById("term-input-row")?.addEventListener("click", () => {
      if (busy) return
      if (!getSelection()?.toString()) input.focus()
    })

    if (reduced) {
      busy = false
    } else {
      output.style.opacity = "0"
      const io = new IntersectionObserver(
        (entries) => {
          if (entries.some((e) => e.isIntersecting)) {
            io.disconnect()
            void runIntro().then(() => (busy = false))
          }
        },
        { threshold: 0.3 }
      )
      io.observe(termEl)
    }
  }
</script>
