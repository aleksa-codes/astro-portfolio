---
import { Icon } from "astro-icon/components"
import { techList } from "@/lib/tech"
import { cn } from "@/lib/utils"

const byName = new Map(techList.map((tech) => [tech.name, tech]))

const groups: { label: string; names: string[] }[] = [
  {
    label: "Language",
    names: ["HTML", "CSS", "JavaScript", "TypeScript", "Python"],
  },
  {
    label: "Frontend",
    names: [
      "React",
      "Next.js",
      "Astro",
      "Tailwind CSS",
      "shadcn/ui",
      "Motion",
      "Expo",
      "Base UI",
      "Radix UI",
      "TanStack",
    ],
  },
  {
    label: "Backend",
    names: [
      "Node.js",
      "Bun",
      "Hono.js",
      "Socket.IO",
      "PostgreSQL",
      "SQLite",
      "Drizzle ORM",
      "Better Auth",
      "Polar.sh",
      "Decap CMS",
      "Keystatic",
      "WordPress",
    ],
  },
  {
    label: "Infrastructure",
    names: [
      "Cloudflare",
      "Netlify",
      "Vercel",
      "Docker",
      "Coolify",
      "Supabase",
      "Neon",
    ],
  },
  {
    label: "AI & Tools",
    names: [
      "Vercel AI SDK",
      "GitHub",
      "VS Code",
      "GitHub Copilot",
      "Cursor",
      "Codex",
      "Claude Code",
      "OpenCode",
    ],
  },
]
---

<section id="tech-stack" class="flex flex-col gap-4 md:gap-6">
  <h2 class="text-sm font-medium tracking-widest text-muted-foreground uppercase">
    Tech I Love Working With
  </h2>
  <dl class="flex flex-col gap-3 md:gap-4">
    {groups.map(({ label, names }) => (
      <div class="grid gap-1 sm:grid-cols-[128px_1fr] sm:items-start sm:gap-4">
        <dt class="flex h-7 items-center text-sm font-medium tracking-wide text-muted-foreground uppercase">
          {label}
        </dt>
        <dd
          tabindex="0"
          aria-label={`${label} technologies`}
          class="-mx-1 min-w-0 overflow-x-auto overscroll-x-contain rounded-sm px-1 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring"
        >
          <div
            class={cn(
              "flex flex-wrap items-center gap-x-1.5 gap-y-1",
              names.length > 6 && "min-w-[42rem]"
            )}
          >
            {names.map((name) => {
              const tech = byName.get(name)
              if (!tech) return null
              return (
                <a
                  href={tech.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex h-7 shrink-0 items-center gap-1.5 rounded-md px-1 text-base leading-6 whitespace-nowrap text-foreground/80 outline-none transition-[background-color,color] duration-150 ease-out hover:bg-muted hover:text-foreground focus-visible:ring-2 focus-visible:ring-ring/50 focus-visible:ring-inset motion-reduce:transition-none"
                >
                  <Icon
                    name={tech.icon}
                    class={cn("size-4 shrink-0", tech.color)}
                  />
                  <span>{tech.name}</span>
                </a>
              )
            })}
          </div>
        </dd>
      </div>
    ))}
  </dl>
</section>
