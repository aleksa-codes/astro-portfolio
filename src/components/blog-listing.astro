---
import Card from "@/components/ui/card.astro"
import { calculateReadingTime } from "@/lib/utils"
import { Icon } from "astro-icon/components"
import { Image } from "astro:assets"

interface Props {
  posts: any[]
}

const { posts } = Astro.props
---

<div class="flex flex-col gap-5 md:gap-6">
  {posts.map((post, index) => {
    const readingTime = calculateReadingTime(post.body ?? "")
    return (
      <Card
        href={`/blog/${post.id}`}
        class="group p-3 transition-[border-color] duration-200 ease-out hover:border-foreground/20"
        contentClass="flex flex-col gap-3 md:flex-row md:items-start"
      >
        <div class="w-full shrink-0 overflow-hidden rounded-md bg-secondary/20 md:w-[56%]">
          {post.data.thumbnail ? (
            <Image
              src={post.data.thumbnail}
              alt=""
              sizes="(min-width: 768px) 380px, calc(100vw - 4rem)"
              priority={index < 2}
              class="w-full transition-transform duration-300 ease-out-strong group-hover:scale-[1.02] motion-reduce:transition-none"
            />
          ) : (
            <div class="flex aspect-video w-full items-center justify-center">
              <Icon
                name="lucide:file-text"
                class="size-8 text-muted-foreground/30"
              />
            </div>
          )}
        </div>

        <div class="flex min-w-0 flex-1 flex-col gap-2.5">
          <h2 class="line-clamp-4 text-pretty text-xl leading-snug font-semibold tracking-tight text-foreground md:text-[1.75rem] md:leading-tight">
            {post.data.title}
          </h2>

          <p class="line-clamp-5 text-pretty text-[0.95rem] leading-relaxed text-muted-foreground">
            {post.data.description}
          </p>

          <div class="flex flex-wrap items-center gap-2 text-sm text-muted-foreground">
            <span class="flex items-center gap-1.5">
              <Icon name="lucide:calendar" class="size-4 shrink-0" />
              <time
                datetime={post.data.date.toISOString()}
                class="tabular-nums"
              >
                {post.data.date.toLocaleDateString("en-US", {
                  month: "short",
                  day: "numeric",
                  year: "numeric",
                })}
              </time>
            </span>
            <span
              aria-hidden="true"
              class="h-1 w-1 rounded-full bg-muted-foreground/50"
            ></span>
            <span class="flex items-center gap-1.5">
              <Icon name="lucide:clock" class="size-4 shrink-0" />
              <span class="tabular-nums">{readingTime} min read</span>
            </span>
            <Icon
              name="lucide:arrow-up-right"
              class="ml-auto size-4 shrink-0 opacity-0 transition-opacity duration-200 ease-out group-hover:opacity-100 motion-reduce:transition-none"
            />
          </div>
        </div>
      </Card>
    )
  })}
</div>
