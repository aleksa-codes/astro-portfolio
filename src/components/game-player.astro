---
import { Icon } from "astro-icon/components"
import Badge from "@/components/ui/badge.astro"
import Button from "@/components/ui/button.astro"
import { games, getModelBadge } from "@/lib/games"

// One badge per model, rendered up front so the script can clone the real
// Badge markup instead of rebuilding it by hand
const models = [...new Set(games.map((game) => game.model))]
---

<div
  id="game-player"
  class="fixed inset-0 z-100 hidden bg-background/80 backdrop-blur-md"
  role="dialog"
  aria-modal="true"
  aria-labelledby="game-player-title"
>
  <div class="flex h-dvh w-full flex-col p-0 sm:p-3">
    <!-- Top bar -->
    <div
      class="flex shrink-0 items-center gap-3 border-b-0 border-border bg-card px-3 py-2 sm:rounded-t-2xl sm:border"
    >
      <div class="flex min-w-0 flex-1 items-center gap-3">
        <Icon
          name="lucide:gamepad-2"
          class="h-5 w-5 shrink-0 text-muted-foreground"
        />
        <h2
          id="game-player-title"
          class="truncate text-sm font-semibold text-foreground sm:text-base"
        >
        </h2>
        <span id="game-player-model" class="hidden sm:contents"></span>
      </div>
      <div class="flex shrink-0 items-center gap-1">
        <Button
          id="game-player-raw"
          href="#"
          target="_blank"
          rel="noopener noreferrer"
          variant="outline"
          size="icon-lg"
          title="Open in new tab"
          aria-label="Open in new tab"
        >
          <Icon name="lucide:external-link" class="h-4.5 w-4.5" />
        </Button>
        <Button
          id="game-player-fullscreen"
          type="button"
          variant="outline"
          size="icon-lg"
          title="Fullscreen"
          aria-label="Fullscreen"
        >
          <Icon name="lucide:maximize" class="h-4.5 w-4.5" />
        </Button>
        <Button
          id="game-player-close"
          type="button"
          variant="outline"
          size="icon-lg"
          title="Close (Esc)"
          aria-label="Close"
          class="bg-destructive/10 hover:bg-destructive/20 dark:bg-destructive/20 dark:hover:bg-destructive/30"
        >
          <Icon name="lucide:x" class="h-5 w-5" />
        </Button>
      </div>
    </div>

    <!-- Game frame -->
    <div
      id="game-player-frame"
      class="relative min-h-0 flex-1 overflow-hidden border-border bg-black sm:rounded-b-2xl sm:border"
    >
      <iframe
        id="game-player-iframe"
        title="Game"
        class="h-full w-full border-0 bg-black"
        allow="fullscreen; autoplay; gamepad; accelerometer; gyroscope"
      ></iframe>
    </div>
  </div>

  {
    models.map((model) => (
      <template data-model-badge={model}>
        <Badge variant="secondary" size="lg" class="shrink-0">
          <Icon
            name={getModelBadge(model).icon}
            style={`color: ${getModelBadge(model).color};`}
          />
          {model}
        </Badge>
      </template>
    ))
  }
</div>

<script>
  const modal = document.getElementById("game-player")!
  const iframe = document.getElementById(
    "game-player-iframe"
  ) as HTMLIFrameElement
  const frame = document.getElementById("game-player-frame")!
  const titleEl = document.getElementById("game-player-title")!
  const modelEl = document.getElementById("game-player-model")!
  const rawLink = document.getElementById(
    "game-player-raw"
  ) as HTMLAnchorElement

  const badgeTemplates = Array.from(
    modal.querySelectorAll<HTMLTemplateElement>("template[data-model-badge]")
  )

  function setModel(model: string) {
    const template = badgeTemplates.find((t) => t.dataset.modelBadge === model)
    if (template?.content.firstElementChild) {
      modelEl.replaceChildren(
        template.content.firstElementChild.cloneNode(true)
      )
    } else {
      modelEl.textContent = model
    }
  }

  let open = false

  const buttons = () =>
    Array.from(
      document.querySelectorAll<HTMLElement>("[data-game-play]")
    ) as HTMLElement[]

  function loadFrame(url: string) {
    const win = iframe.contentWindow
    if (win) win.location.replace(url)
    else iframe.src = url
  }

  function show(btn: HTMLElement) {
    const file = btn.dataset.gameFile!
    titleEl.textContent = btn.dataset.gameTitle ?? "Game"
    rawLink.href = file
    loadFrame(file)

    setModel(btn.dataset.gameModel ?? "")

    modal.classList.remove("hidden")
    document.body.style.overflow = "hidden"
    open = true
    iframe.focus()
  }

  function hide() {
    if (!open) return
    if (document.fullscreenElement) document.exitFullscreen()
    modal.classList.add("hidden")
    loadFrame("about:blank")
    document.body.style.overflow = ""
    open = false
  }

  function syncFromUrl() {
    const slug = location.hash.startsWith("#play-")
      ? location.hash.slice("#play-".length)
      : null

    if (!slug) {
      hide()
      return
    }

    const btn = buttons().find((b) => b.dataset.gameSlug === slug)
    if (btn) show(btn)
    else hide()
  }

  buttons().forEach((btn) => {
    btn.addEventListener("click", (e) => {
      e.preventDefault()
      const url = `${location.pathname}${location.search}#play-${btn.dataset.gameSlug}`
      history.pushState({ game: btn.dataset.gameSlug }, "", url)
      show(btn)
    })
  })

  function close() {
    hide()
    if (location.hash.startsWith("#play-"))
      history.replaceState(null, "", location.pathname + location.search)
  }

  document.getElementById("game-player-close")!.addEventListener("click", close)

  document
    .getElementById("game-player-fullscreen")!
    .addEventListener("click", () => {
      if (document.fullscreenElement) document.exitFullscreen()
      else frame.requestFullscreen?.()
    })

  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && open && !document.fullscreenElement) close()
  })

  window.addEventListener("popstate", syncFromUrl)
  window.addEventListener("hashchange", syncFromUrl)
  syncFromUrl()
</script>
