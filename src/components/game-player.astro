      '<g fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"><path d="M11.017 2.814a1 1 0 0 1 1.966 0l1.051 5.558a2 2 0 0 0 1.594 1.594l5.558 1.051a1 1 0 0 1 0 1.966l-5.558 1.051a2 2 0 0 0-1.594 1.594l-1.051 5.558a1 1 0 0 1-1.966 0l-1.051-5.558a2 2 0 0 0-1.594-1.594l-5.558-1.051a1 1 0 0 1 0-1.966l5.558-1.051a2 2 0 0 0 1.594-1.594zM20 2v4m2-2h-4"/><circle cx="4" cy="20" r="2"/></g>',
  }

  let open = false

  const buttons = () =>
    Array.from(
      document.querySelectorAll<HTMLElement>("[data-game-play]")
    ) as HTMLElement[]

  function loadFrame(url: string) {
    const win = iframe.contentWindow
    if (win) win.location.replace(url)
    else iframe.src = url
  }

  function show(btn: HTMLElement) {
    const file = btn.dataset.gameFile!
    titleEl.textContent = btn.dataset.gameTitle ?? "Game"
    rawLink.href = file
    loadFrame(file)

    const model = btn.dataset.gameModel ?? ""
    const iconName = btn.dataset.gameModelIcon ?? ""
    const color = btn.dataset.gameModelColor ?? ""
    if (iconName && iconSvgs[iconName]) {
      const size = "h-3.5 w-3.5"
      modelEl.innerHTML = `<svg class="${size} shrink-0" viewBox="0 0 24 24" fill="currentColor" style="color: ${color}"><title>${model}</title>${iconSvgs[iconName]}</svg> ${model}`
    } else {
      modelEl.textContent = model
    }

    modal.classList.remove("hidden")
    document.body.style.overflow = "hidden"
    open = true
    iframe.focus()
  }

  function hide() {
    if (!open) return
    if (document.fullscreenElement) document.exitFullscreen()
    modal.classList.add("hidden")
    loadFrame("about:blank")
    document.body.style.overflow = ""
    open = false
  }

  function syncFromUrl() {
    const slug = location.hash.startsWith("#play-")
      ? location.hash.slice("#play-".length)
      : null

    if (!slug) {
      hide()
      return
    }

    const btn = buttons().find((b) => b.dataset.gameSlug === slug)
    if (btn) show(btn)
    else hide()
  }

  buttons().forEach((btn) => {
    btn.addEventListener("click", (e) => {
      e.preventDefault()
      const url = `${location.pathname}${location.search}#play-${btn.dataset.gameSlug}`
      history.pushState({ game: btn.dataset.gameSlug }, "", url)
      show(btn)
    })
  })

  function close() {
    hide()
    if (location.hash.startsWith("#play-"))
      history.replaceState(null, "", location.pathname + location.search)
  }

  document.getElementById("game-player-close")!.addEventListener("click", close)

  document
    .getElementById("game-player-fullscreen")!
    .addEventListener("click", () => {
      if (document.fullscreenElement) document.exitFullscreen()
      else frame.requestFullscreen?.()
    })

  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && open && !document.fullscreenElement) close()
  })

  window.addEventListener("popstate", syncFromUrl)
  window.addEventListener("hashchange", syncFromUrl)
  syncFromUrl()
</script>
