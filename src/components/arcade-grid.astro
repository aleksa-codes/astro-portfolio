---
import Button from "@/components/ui/button.astro"
import { getModelBadge, type Game } from "@/lib/games"
import { Icon } from "astro-icon/components"
import { Image } from "astro:assets"

interface Props {
  games: Game[]
  priority?: boolean
}

const { games, priority = false } = Astro.props
---

<ul
  aria-label="Browser games"
  class="grid gap-x-10 gap-y-12 md:grid-cols-2 md:gap-y-16"
>
  {games.map((game, index) => {
    const model = getModelBadge(game.model)
    return (
      <li class="min-w-0">
        <article class="flex h-full min-w-0 flex-col">
          <button
            type="button"
            class="relative block aspect-video w-full cursor-pointer overflow-hidden rounded-xl ring-1 ring-border/50 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-ring"
            data-game-play
            data-game-slug={game.slug}
            data-game-file={game.file}
            data-game-title={game.title}
            data-game-model={game.model}
            aria-label={`Play ${game.title}`}
          >
            {game.image ? (
              <Image
                src={game.image}
                alt={game.title}
                sizes="(min-width: 896px) 404px, (min-width: 768px) calc((100vw - 88px) / 2), calc(100vw - 48px)"
                priority={priority && index < 2}
                class="block h-full w-full object-cover"
              />
            ) : (
              <span class="flex h-full w-full items-center justify-center bg-muted">
                <Icon
                  name="lucide:gamepad-2"
                  class="size-8 text-muted-foreground"
                />
              </span>
            )}
          </button>

          <div class="mt-5 flex min-w-0 items-start justify-between gap-3">
            <h2 class="min-w-0 text-lg leading-6 font-semibold tracking-tight text-foreground">
              {game.title}
            </h2>
            <p class="inline-flex min-h-6 shrink-0 items-center gap-1.5 text-sm whitespace-nowrap text-muted-foreground">
              <Icon
                name={model.icon}
                class="size-4 shrink-0"
                style={model.color ? `color: ${model.color};` : undefined}
              />
              <span>{game.model}</span>
            </p>
          </div>

          <p class="mt-3 text-base leading-relaxed text-pretty text-muted-foreground">
            {game.description}
          </p>

          <div class="mt-auto grid grid-cols-2 gap-2 pt-5">
            <Button
              size="xl"
              class="h-11 w-full gap-2 rounded-lg px-4 text-base transition-colors motion-reduce:transition-none"
              data-game-play
              data-game-slug={game.slug}
              data-game-file={game.file}
              data-game-title={game.title}
              data-game-model={game.model}
              aria-label={`Play ${game.title}`}
            >
              <Icon name="lucide:play" class="size-4" />
              Play
            </Button>
            <Button
              type="button"
              variant="outline"
              size="xl"
              class="h-11 w-full gap-2 rounded-lg px-4 text-base text-foreground transition-colors hover:border-foreground/20 motion-reduce:transition-none"
              data-prompt-open
              data-prompt={game.prompt}
              data-prompt-title={game.title}
              data-prompt-model={game.model}
              aria-label={`View the prompt for ${game.title}`}
            >
              <Icon name="lucide:text-quote" class="size-4" />
              Prompt
            </Button>
          </div>
        </article>
      </li>
    )
  })}
</ul>
