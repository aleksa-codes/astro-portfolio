---
import { Icon } from "astro-icon/components"
import Card from "@/components/ui/card.astro"
import { cn } from "@/lib/utils"

interface Props {
  title: string
  icon?: string
  href?: string
  class?: string
}

const { title, icon, href, class: className } = Astro.props
---

<Card class={cn("h-full p-0", className)}>
  <div
    class="flex h-11 shrink-0 items-center gap-2 border-b border-border bg-secondary/40 px-4 py-2"
  >
    {
      icon && (
        <Icon
          name={icon}
          class="h-4 w-4 shrink-0 text-green-500 md:h-5 md:w-5"
        />
      )
    }
    <h3 class="truncate text-sm font-semibold text-foreground md:text-base">
      {title}
    </h3>
    {
      href && (
        <a
          href={href}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={`Open ${title} in a new tab`}
          class="flex h-6 w-6 shrink-0 items-center justify-center rounded-md text-muted-foreground/60 transition-colors duration-150 hover:bg-foreground/10 hover:text-foreground focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring"
        >
          <Icon name="lucide:external-link" class="h-3.5 w-3.5 md:h-4 md:w-4" />
        </a>
      )
    }
    <div class="ml-auto flex shrink-0 items-center gap-2" aria-hidden="true">
      <span class="h-3 w-3 rounded-full bg-[#ff5f57]/80"></span>
      <span class="h-3 w-3 rounded-full bg-[#febc2e]/80"></span>
      <span class="h-3 w-3 rounded-full bg-[#28c840]/80"></span>
    </div>
  </div>
  <div class="flex min-h-0 flex-1 flex-col">
    <slot />
  </div>
</Card>
