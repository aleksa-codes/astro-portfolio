{
  "name": "astro-portfolio",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "astro": "astro",
    "build": "astro check && astro build && bun run build:tailwind && bun run build:postcss",
    "build:postcss": "postcss dist/global.css -o dist/global.css",
    "build:tailwind": "bun x @tailwindcss/cli -i src/styles/global.css -o dist/global.css --minify",
    "decap": "bun x decap-server",
    "dev": "astro dev",
    "format": "prettier --write .",
    "preview": "astro preview"
  },
  "dependencies": {
    "@ai-sdk/groq": "^4.0.46",
    "@astrojs/netlify": "^8.2.6",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "ai": "^7.0.107",
    "astro": "^7.3.3",
    "astro-expressive-code": "^0.44.2",
    "astro-icon": "^1.2.0",
    "astro-og-canvas": "^0.13.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "marked": "^18.0.13",
    "remend": "^1.3.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@iconify-json/bxl": "^1.2.4",
    "@iconify-json/iconoir": "^1.2.11",
    "@iconify-json/lucide": "^1.2.135",
    "@iconify-json/simple-icons": "^1.2.97",
    "@iconify-json/tabler": "^1.2.39",
    "@swc/core": "^1.16.2",
    "@swc/html": "^1.16.2",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "postcss-cli": "^12.0.0",
    "prettier": "^3.9.8",
    "prettier-plugin-astro": "^1.0.1",
    "prettier-plugin-organize-imports": "^4.3.0",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "schema-dts": "^2.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3"
  }
}
